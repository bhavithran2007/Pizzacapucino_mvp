NODE_ENV=development
PORT=4000
# Local dev: mysql://root:password@localhost:3306/pizzacapucino_mvp
# Production (TiDB Cloud Serverless, free tier): get this from your cluster's
# "Connect" panel, e.g.
# mysql://<user>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/pizzacapucino?sslaccept=strict
DATABASE_URL="mysql://root:password@localhost:3306/pizzacapucino_mvp"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="12h"
ADMIN_COOKIE_NAME="admin_token"
# Set this to your deployed URL in production, e.g. https://pizzacapucino.onrender.com
CORS_ORIGIN="http://localhost:4000"

# Cloudinary (free tier) — used to store menu item images so they survive
# redeploys on free hosts. Sign up at cloudinary.com, then either set
# CLOUDINARY_URL (from your dashboard) OR the three separate fields below.
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

RESTAURANT_NAME="Pizza Capucino"
PUBLIC_UPI_QR_URL="https://example.com/your-gpay-qr.png"
WHATSAPP_BOOKING_NUMBER="+918680986888"

ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="ChangeMe123!"
ADMIN_SEED_EMAIL="admin@pizzacapucino.local"
ADMIN_SEED_FULL_NAME="Pizza Capucino Admin"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="pizzacapucino@gmail.com"
SMTP_FROM_NAME="Pizza Capucino"
